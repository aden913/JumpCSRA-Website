# JumpCSRA Email Server Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-linode-domain.com

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=jumpcsra@gmail.com
SENDGRID_FROM_NAME=JumpCSRA Party Rentals

# Firebase Configuration (Use existing project)
FIREBASE_PROJECT_ID=pppro-b060e
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY=your_firebase_private_key_here

# Security
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
API_KEY=jumpcsra_secure_api_key_2024

# Email Scheduling
CART_REMINDER_DELAY_HOURS=24
DEPOSIT_REMINDER_DELAY_DAYS=7
EVENT_CONFIRMATION_DAYS_BEFORE=2
POST_EVENT_THANKS_DAYS_AFTER=1
REBOOKING_REMINDER_MONTHS_AFTER=9

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/email-server.log